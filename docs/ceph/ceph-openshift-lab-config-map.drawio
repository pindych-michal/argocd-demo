<mxfile host="app.diagrams.net" modified="2026-11-05T00:00:00.000Z" agent="generator" version="24.7.17" type="device"><diagram id="ceph-ocp-lab" name="Ceph ↔ OpenShift lab"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1651" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="External Ceph  ↔  OpenShift (ceph-csi)  —  lab configuration map" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A1A1A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="14.0" width="1500.0" height="34.0" as="geometry"/></mxCell><mxCell id="subtitle" value="Ceph Tentacle 20.2.5 in VM &lt;b&gt;ceph1&lt;/b&gt; on Proxmox VE host 1  ·  OpenShift 4.22.16 single-node (SNO) in a VM on Proxmox VE host 2  ·  one shared LAN 192.168.200.0/24  ·  RBD block storage only (RWO)  ·  state as of 2026-11-05.&lt;br&gt;Read left → right: what exists on Ceph · how it is reached · which OpenShift objects point at it. Yellow boxes hold the values that must be identical on both sides; gold dashed lines connect them." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="50.0" width="2260.0" height="40.0" as="geometry"/></mxCell><mxCell id="A" value='CEPH SIDE (step 1)  —  VM "ceph1" (ID 200) on Proxmox VE host 1 "mgt"  ·  Ceph Tentacle 20.2.5, cephadm, single host  ·  192.168.200.66' style="swimlane;html=1;startSize=34;fontSize=13;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFBF6;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="96.0" width="720.0" height="1175.0" as="geometry"/></mxCell><mxCell id="A1b" value='&lt;b&gt;Host / VM / bootstrap&lt;/b&gt; — Rocky Linux 9 · 4 vCPU · 12 GB RAM · scsi0 40 GB OS · scsi1–3 = 3 × 100 GB (local-lvm thin) · IP 192.168.200.66 · Proxmox snapshot "ceph-ready" = rollback point&lt;br&gt;&lt;b&gt;cephadm bootstrap&lt;/b&gt; --mon-ip 192.168.200.66 &lt;b&gt;--single-host-defaults&lt;/b&gt; --skip-monitoring-stack · image quay.io/ceph/ceph:v20 · fsid 0cfab0ec-d786-11f1-a6db-bc24110d7b3a (&lt;i&gt;not&lt;/i&gt; used by ceph-csi with the operator)&lt;br&gt;OS prep: podman · lvm2 · chrony · firewalld (services ceph-mon + ceph) · qemu-guest-agent · cephadm add-repo --release tentacle · ceph-common (ceph / rbd CLI)' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A"><mxGeometry x="20.0" y="46.0" width="680.0" height="90.0" as="geometry"/></mxCell><mxCell id="A2" value="Daemons  (ceph orch ps · ceph -s)" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#FFF1E0;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="A"><mxGeometry x="20.0" y="191.8" width="680.0" height="193.0" as="geometry"/></mxCell><mxCell id="A2ports" value="&lt;b&gt;Listening ports (firewalld)&lt;/b&gt;&lt;br&gt;MON 3300 (v2) + 6789 (v1)&lt;br&gt;OSD / MGR 6800–7300&lt;br&gt;dashboard 8443 (https)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A2"><mxGeometry x="16.0" y="34.0" width="200.0" height="76.0" as="geometry"/></mxCell><mxCell id="A2mgr" value="&lt;b&gt;MGR × 2&lt;/b&gt;&lt;br&gt;ceph1.ufamdj (active)&lt;br&gt;ceph1.ssaoyu (standby, modules off)&lt;br&gt;dashboard https://192.168.200.66:8443" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A2"><mxGeometry x="236.0" y="34.0" width="200.0" height="76.0" as="geometry"/></mxCell><mxCell id="A2mon" value="&lt;b&gt;MON mon.ceph1&lt;/b&gt; (1 of 1, quorum leader)&lt;br&gt;v2 192.168.200.66:&lt;b&gt;3300&lt;/b&gt;&lt;br&gt;v1 192.168.200.66:&lt;b&gt;6789&lt;/b&gt;&lt;br&gt;← the only address OpenShift is given" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="A2"><mxGeometry x="456.0" y="34.0" width="208.0" height="76.0" as="geometry"/></mxCell><mxCell id="A2osd0" value="&lt;b&gt;osd.0&lt;/b&gt; · class ssd · 100 GiB · /dev/sdb · BlueStore&lt;br&gt;ceph orch daemon add osd ceph1:/dev/sdb" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A2"><mxGeometry x="16.0" y="120.0" width="200.0" height="63.0" as="geometry"/></mxCell><mxCell id="A2osd1" value="&lt;b&gt;osd.1&lt;/b&gt; · class ssd · 100 GiB · /dev/sdc · BlueStore&lt;br&gt;ceph orch daemon add osd ceph1:/dev/sdc" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A2"><mxGeometry x="236.0" y="120.0" width="200.0" height="63.0" as="geometry"/></mxCell><mxCell id="A2osd2" value="&lt;b&gt;osd.2&lt;/b&gt; · class ssd · 100 GiB · /dev/sdd · BlueStore&lt;br&gt;ceph orch daemon add osd ceph1:/dev/sdd" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A2"><mxGeometry x="456.0" y="120.0" width="208.0" height="63.0" as="geometry"/></mxCell><mxCell id="A3b" value="&lt;b&gt;Data placement (CRUSH) — set by --single-host-defaults&lt;/b&gt;&lt;br&gt;replicated rule, failure domain = &lt;b&gt;osd&lt;/b&gt; (osd_crush_chooseleaf_type 0) · pool size &lt;b&gt;2&lt;/b&gt; / min_size &lt;b&gt;1&lt;/b&gt; → every object lives on 2 of the 3 OSDs · write acknowledged after both replicas persist · raw 300 GiB ≈ 150 GiB usable · one failed OSD = degraded, I/O continues, self-healing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A"><mxGeometry x="20.0" y="440.6" width="680.0" height="50.0" as="geometry"/></mxCell><mxCell id="A5" value="cephx authentication  (ceph auth · ceph mon set)" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#FFF1E0;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="A"><mxGeometry x="20.0" y="546.4" width="680.0" height="227.0" as="geometry"/></mxCell><mxCell id="A5mon" value="&lt;b&gt;MON auth settings&lt;/b&gt; — auth_allowed_ciphers = &lt;b&gt;aes, aes256k&lt;/b&gt; (a fresh 20.2.4+ cluster allows aes256k only) · auth_preferred_cipher aes256k (default type of new keys) · mon_allow_pool_delete true (lab convenience)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A5"><mxGeometry x="16.0" y="34.0" width="648.0" height="37.0" as="geometry"/></mxCell><mxCell id="A5admin" value="&lt;b&gt;client.admin&lt;/b&gt;&lt;br&gt;key type aes256k · caps allow * (every pool, every daemon)&lt;br&gt;stays on the Ceph VM — never handed to OpenShift" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A5"><mxGeometry x="16.0" y="81.0" width="300.0" height="76.0" as="geometry"/></mxCell><mxCell id="A5ocp" value="&lt;b&gt;client.ocp-rbd&lt;/b&gt; — key type &lt;b&gt;aes&lt;/b&gt; (the RHCOS 5.14 kernel cannot use aes256k)&lt;br&gt;caps: mon 'profile rbd' · osd 'profile rbd &lt;b&gt;pool=ocp-rbd&lt;/b&gt;' · mgr 'profile rbd pool=ocp-rbd'&lt;br&gt;key AQCY… → copied into the OpenShift Secret" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="A5"><mxGeometry x="336.0" y="81.0" width="328.0" height="76.0" as="geometry"/></mxCell><mxCell id="A5mute" value="&lt;b&gt;Health mutes (--sticky) — expected in this lab, caused by the aes key&lt;/b&gt;&lt;br&gt;AUTH_INSECURE_KEYS_ALLOWED · AUTH_INSECURE_KEYS_CREATABLE · AUTH_INSECURE_CLIENT_KEY_TYPE  →  ceph -s = HEALTH_OK (muted: …)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A5"><mxGeometry x="16.0" y="167.0" width="648.0" height="50.0" as="geometry"/></mxCell><mxCell id="A4" value="Pools  (ceph osd pool ls detail)" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#FFF1E0;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="A"><mxGeometry x="20.0" y="829.2" width="680.0" height="94.0" as="geometry"/></mxCell><mxCell id="A4mgr" value="&lt;b&gt;.mgr&lt;/b&gt;&lt;br&gt;internal (MGR modules)&lt;br&gt;1 PG · created automatically" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A4"><mxGeometry x="16.0" y="34.0" width="170.0" height="50.0" as="geometry"/></mxCell><mxCell id="A4ocp" value="&lt;b&gt;ocp-rbd&lt;/b&gt; — application: &lt;b&gt;rbd&lt;/b&gt; (rbd pool init) · 32 PGs · size 2 · quota max_bytes 100 GiB&lt;br&gt;one pool = one application → block images only (CephFS / RGW would need their own pools)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="A4"><mxGeometry x="206.0" y="34.0" width="458.0" height="50.0" as="geometry"/></mxCell><mxCell id="A6" value="RBD images in pool ocp-rbd  —  created by ceph-csi, never by hand  (rbd ls -l ocp-rbd · rbd du -p ocp-rbd)" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#FFF1E0;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="A"><mxGeometry x="20.0" y="979.0" width="680.0" height="176.0" as="geometry"/></mxCell><mxCell id="A6test" value="&lt;b&gt;csi-vol-&amp;lt;uuid&amp;gt; × 2 — 2 GiB&lt;/b&gt;&lt;br&gt;← PVC ceph-rbd-fs (ext4; mapped on the node → &lt;b&gt;watcher 192.168.200.100&lt;/b&gt;)&lt;br&gt;← PVC ceph-rbd-block (volumeMode Block)&lt;br&gt;features: layering · image-meta: csi.storage.k8s.io/pvc/name, pvc/namespace, pv/name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A6"><mxGeometry x="16.0" y="34.0" width="316.0" height="90.0" as="geometry"/></mxCell><mxCell id="A6gold" value="&lt;b&gt;csi-vol-&amp;lt;uuid&amp;gt; × 6 — 30 GiB virtual (~1–2 GiB used each)&lt;/b&gt;&lt;br&gt;← OpenShift Virtualization golden images (RHEL 8/9/10, CentOS Stream 9/10, Fedora)&lt;br&gt;imported automatically because ceph-rbd carries the is-default-virt-class annotation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="A6"><mxGeometry x="348.0" y="34.0" width="316.0" height="90.0" as="geometry"/></mxCell><mxCell id="A6note" value='&lt;b&gt;Snapshots &amp;amp; clones:&lt;/b&gt; VolumeSnapshot ceph-rbd-fs-snap → &lt;i&gt;rbd snap&lt;/i&gt; on the image · restored PVC → &lt;i&gt;rbd clone&lt;/i&gt; (needs layering) · deleting the PVC removes the image (reclaimPolicy Delete) · dashboard: Block → Images (Usage shows "-" without object-map / fast-diff)' style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=wrap;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="A6"><mxGeometry x="16.0" y="134.0" width="648.0" height="32.0" as="geometry"/></mxCell><mxCell id="C" value="OPENSHIFT SIDE (step 2)  —  SNO VM on Proxmox VE host 2  ·  OpenShift 4.22.16 (Kubernetes 1.35.8)  ·  node api.m1.local.net 192.168.200.100  ·  managed from WSL with oc" style="swimlane;html=1;startSize=34;fontSize=13;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#F7FAFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1050.0" y="96.0" width="1250.0" height="1175.0" as="geometry"/></mxCell><mxCell id="C3" value="Runtime objects created by the operator (purple = never written by hand)" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="20.0" y="46.0" width="600.0" height="362.0" as="geometry"/></mxCell><mxCell id="C3ctrl" value="&lt;b&gt;Deployment rbd.csi.ceph.com-ctrlplugin&lt;/b&gt; (1 replica)&lt;br&gt;5/5: csi-rbdplugin · csi-provisioner · csi-attacher · csi-resizer · csi-snapshotter&lt;br&gt;SA …-rbd-ctrlplugin-sa · pod network (egress SNAT → node IP)&lt;br&gt;does: rbd create / rm / resize / snap / clone (librados)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#E8DDF0;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="C3"><mxGeometry x="16.0" y="34.0" width="280.0" height="116.0" as="geometry"/></mxCell><mxCell id="C3np" value="&lt;b&gt;DaemonSet rbd.csi.ceph.com-nodeplugin&lt;/b&gt; (1 pod per node)&lt;br&gt;2/2: csi-rbdplugin · driver-registrar&lt;br&gt;SA …-rbd-nodeplugin-sa · hostNetwork · hostPID · privileged · SYS_ADMIN · hostPath /dev /sys /lib/modules /var/lib/kubelet&lt;br&gt;does: NodeStage / NodePublish = rbd map · mkfs · mount" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#E8DDF0;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="C3"><mxGeometry x="304.0" y="34.0" width="280.0" height="116.0" as="geometry"/></mxCell><mxCell id="C3node" value="&lt;b&gt;RHCOS node api.m1.local.net&lt;/b&gt; — kernel 5.14 (RHEL 9) · 192.168.200.100 on br-ex (OVN-Kubernetes)&lt;br&gt;krbd: rbd map → /dev/rbdX → mkfs.ext4 + mount into the pod, or raw device for a VM disk" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#E3EEFB;strokeColor=#6C8EBF;" vertex="1" parent="C3"><mxGeometry x="16.0" y="172.0" width="280.0" height="63.0" as="geometry"/></mxCell><mxCell id="C3csidriver" value="&lt;b&gt;CSIDriver rbd.csi.ceph.com&lt;/b&gt;&lt;br&gt;attachRequired true · podInfoOnMount true · fsGroupPolicy File&lt;br&gt;name = Driver name = StorageClass.provisioner" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#E8DDF0;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="C3"><mxGeometry x="304.0" y="172.0" width="280.0" height="63.0" as="geometry"/></mxCell><mxCell id="C3cm" value='&lt;b&gt;ConfigMap ceph-csi-config&lt;/b&gt; (mounted in both plugins)&lt;br&gt;config.json: [{"clusterID": "&lt;b&gt;ceph1&lt;/b&gt;",&lt;br&gt;&amp;nbsp;&amp;nbsp;"monitors": ["&lt;b&gt;192.168.200.66:6789&lt;/b&gt;"]}]' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#E8DDF0;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="C3"><mxGeometry x="16.0" y="257.0" width="280.0" height="63.0" as="geometry"/></mxCell><mxCell id="C3note" value="also created: NetworkPolicy, logrotate ConfigMap, liveness Service" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=wrap;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="C3"><mxGeometry x="304.0" y="257.0" width="150.0" height="63.0" as="geometry"/></mxCell><mxCell id="C1" value="Ceph-CSI Operator v1.1.0 — install-openshift.yaml · ns ceph-csi-operator-system" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="640.0" y="46.0" width="590.0" height="362.0" as="geometry"/></mxCell><mxCell id="C1scc" value="&lt;b&gt;SCC ceph-csi-operator-ceph-csi-scc&lt;/b&gt; (OpenShift only)&lt;br&gt;privileged · hostNetwork / PID / IPC · hostPath · SYS_ADMIN · RunAsAny&lt;br&gt;granted to the driver SAs via ClusterRole …-ceph-csi-scc-user + 8 ClusterRoleBindings ← needs the patch below" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C1"><mxGeometry x="16.0" y="34.0" width="272.0" height="103.0" as="geometry"/></mxCell><mxCell id="C1op" value='&lt;b&gt;Deployment ceph-csi-operator-controller-manager&lt;/b&gt; (1/1)&lt;br&gt;quay.io/cephcsi/ceph-csi-operator:v1.1.0 · --leader-elect · WATCH_NAMESPACE="" · non-privileged, 128 Mi&lt;br&gt;reconcile loop: watches the CRs → creates / updates the runtime objects (ownerReferences)' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C1"><mxGeometry x="302.0" y="34.0" width="272.0" height="103.0" as="geometry"/></mxCell><mxCell id="C1crd" value="&lt;b&gt;6 CRDs — csi.ceph.io/v1&lt;/b&gt;&lt;br&gt;Driver · CephConnection · ClientProfile · ClientProfileMapping · ClientProfileReplication · OperatorConfig&lt;br&gt;(87 % of the 17.8k-line manifest = OpenAPI schemas)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C1"><mxGeometry x="16.0" y="147.0" width="272.0" height="90.0" as="geometry"/></mxCell><mxCell id="C1rbac" value="&lt;b&gt;RBAC&lt;/b&gt; — 9 ServiceAccounts (operator + {rbd, cephfs, nfs, nvmeof} × {ctrlplugin, nodeplugin}) · 7 Roles · 25 ClusterRoles (manager, CSI sidecar rights, editor/viewer templates) · 25 bindings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C1"><mxGeometry x="302.0" y="147.0" width="272.0" height="90.0" as="geometry"/></mxCell><mxCell id="C1bug" value='&lt;b&gt;⚠ Manifest bug (v1.1.0 and main):&lt;/b&gt; ClusterRole …-scc-user lists resourceNames [ceph-csi-scc], but the SCC is named ceph-csi-operator-ceph-csi-scc → driver pods are rejected ("unable to validate against any security context constraint"). &lt;b&gt;Fix:&lt;/b&gt; oc patch clusterrole … resourceNames → [ceph-csi-operator-ceph-csi-scc, ceph-csi-scc] · rollout restart deploy + ds · re-check after every oc apply of a newer manifest.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="C1"><mxGeometry x="16.0" y="247.0" width="558.0" height="63.0" as="geometry"/></mxCell><mxCell id="C1note" value="Installed from YAML, not OLM (no Subscription / CSV) → absent from Ecosystem → Installed Operators; see Workloads → Deployments. Upgrade = oc apply newer manifest." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=wrap;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="C1"><mxGeometry x="16.0" y="320.0" width="558.0" height="32.0" as="geometry"/></mxCell><mxCell id="C2" value="Custom resources" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="20.0" y="428.0" width="600.0" height="189.0" as="geometry"/></mxCell><mxCell id="C2conn" value="&lt;b&gt;CephConnection ceph1&lt;/b&gt;&lt;br&gt;spec.monitors:&lt;br&gt;&amp;nbsp;&amp;nbsp;- &lt;b&gt;192.168.200.66:6789&lt;/b&gt;&lt;br&gt;only MON addresses — the client fetches the OSD map from the MON" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="C2"><mxGeometry x="16.0" y="34.0" width="180.0" height="103.0" as="geometry"/></mxCell><mxCell id="C2prof" value="&lt;b&gt;ClientProfile ceph1&lt;/b&gt;&lt;br&gt;spec.cephConnectionRef.name: ceph1&lt;br&gt;&lt;b&gt;metadata.name = clusterID&lt;/b&gt; used by StorageClass and VolumeSnapshotClass (not the Ceph fsid)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="C2"><mxGeometry x="212.0" y="34.0" width="176.0" height="103.0" as="geometry"/></mxCell><mxCell id="C2driver" value="&lt;b&gt;Driver rbd.csi.ceph.com&lt;/b&gt;&lt;br&gt;spec.controllerPlugin.replicas: 1 (SNO)&lt;br&gt;everything else = defaults&lt;br&gt;name = CSI driver name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C2"><mxGeometry x="404.0" y="34.0" width="180.0" height="103.0" as="geometry"/></mxCell><mxCell id="C2note" value="you create these three with oc create -f ocp-ceph-connection.yaml / ocp-driver-rbd.yaml (ns ceph-csi-operator-system)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=wrap;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="C2"><mxGeometry x="16.0" y="147.0" width="380.0" height="32.0" as="geometry"/></mxCell><mxCell id="C8" value="Pre-existing operators (OLM) — not modified" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#F0F0F0;strokeColor=#8C8C8C;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="640.0" y="428.0" width="590.0" height="189.0" as="geometry"/></mxCell><mxCell id="C8lvm" value="&lt;b&gt;LVM Storage 4.22&lt;/b&gt; (ns openshift-storage)&lt;br&gt;LVMCluster → StorageClass &lt;b&gt;lvms-vg1 (default)&lt;/b&gt; · provisioner topolvm.io · WaitForFirstConsumer&lt;br&gt;stays the cluster default for ordinary PVCs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontColor=#333333;" vertex="1" parent="C8"><mxGeometry x="16.0" y="34.0" width="272.0" height="90.0" as="geometry"/></mxCell><mxCell id="C8nmstate" value="&lt;b&gt;Kubernetes NMState Operator 4.22&lt;/b&gt; (ns openshift-nmstate)&lt;br&gt;not used yet → step 1b: NodeNetworkConfigurationPolicy for a second NIC (static IP in the storage subnet, dhcp false, no gateway — the default route must stay on br-ex)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FAFAFA;strokeColor=#8C8C8C;fontColor=#555555;dashed=1;dashPattern=5 3;" vertex="1" parent="C8"><mxGeometry x="302.0" y="34.0" width="272.0" height="90.0" as="geometry"/></mxCell><mxCell id="C4" value="Storage API objects" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="20.0" y="637.0" width="600.0" height="255.0" as="geometry"/></mxCell><mxCell id="C4secret" value="&lt;b&gt;Secret csi-rbd-secret&lt;/b&gt; (ns ceph-csi-operator-system)&lt;br&gt;userID: &lt;b&gt;ocp-rbd&lt;/b&gt;&lt;br&gt;userKey: &lt;b&gt;AQCY…&lt;/b&gt; (aes) — identical to client.ocp-rbd&lt;br&gt;read by the CSI sidecars per request and handed to the plugin" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="C4"><mxGeometry x="16.0" y="34.0" width="260.0" height="103.0" as="geometry"/></mxCell><mxCell id="C4vsc" value="&lt;b&gt;VolumeSnapshotClass ceph-rbd-snap&lt;/b&gt;&lt;br&gt;driver rbd.csi.ceph.com · clusterID ceph1 · deletionPolicy Delete&lt;br&gt;snapshotter-secret-name / -namespace → csi-rbd-secret" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C4"><mxGeometry x="312.0" y="34.0" width="228.0" height="103.0" as="geometry"/></mxCell><mxCell id="C4sc" value='&lt;b&gt;StorageClass ceph-rbd&lt;/b&gt; (not the cluster default — lvms-vg1 stays) · provisioner &lt;b&gt;rbd.csi.ceph.com&lt;/b&gt;&lt;br&gt;parameters: clusterID &lt;b&gt;ceph1&lt;/b&gt; · pool &lt;b&gt;ocp-rbd&lt;/b&gt; · imageFeatures layering · csi.storage.k8s.io/fstype ext4 · provisioner- / controller-expand- / node-stage-secret-name + -namespace → csi-rbd-secret&lt;br&gt;reclaimPolicy Delete · allowVolumeExpansion true · volumeBindingMode Immediate&lt;br&gt;annotation &lt;b&gt;storageclass.kubevirt.io/is-default-virt-class: "true"&lt;/b&gt; → default disk class for OpenShift Virtualization (also triggers the golden-image import)' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="C4"><mxGeometry x="16.0" y="155.0" width="568.0" height="90.0" as="geometry"/></mxCell><mxCell id="C7" value="OpenShift Virtualization 4.22.12 (ns openshift-cnv) — pre-existing" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#F0F0F0;strokeColor=#8C8C8C;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="640.0" y="637.0" width="590.0" height="255.0" as="geometry"/></mxCell><mxCell id="C7hco" value="&lt;b&gt;HyperConverged kubevirt-hyperconverged&lt;/b&gt; — enableCommonBootImageImport: true (default) · SCCs kubevirt-controller / kubevirt-handler · HostPathProvisioner · needs nested virtualization on the SNO VM (/dev/kvm)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontColor=#333333;" vertex="1" parent="C7"><mxGeometry x="16.0" y="34.0" width="558.0" height="50.0" as="geometry"/></mxCell><mxCell id="C7dic" value="&lt;b&gt;DataImportCron × 6 → DataVolume → PVC&lt;/b&gt; in ns openshift-virtualization-os-images&lt;br&gt;rhel8 · rhel9 · rhel10 · centos-stream9 · centos-stream10 · fedora — 30 GiB each, volumeMode Block, storageClass &lt;b&gt;ceph-rbd&lt;/b&gt; (selected through is-default-virt-class) → the six 30 GiB csi-vol images on the Ceph side" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontColor=#333333;" vertex="1" parent="C7"><mxGeometry x="16.0" y="94.0" width="558.0" height="50.0" as="geometry"/></mxCell><mxCell id="C7vm" value="&lt;b&gt;Step 3 (planned): VirtualMachine with its disk on Ceph&lt;/b&gt; — DataVolume cloned from a golden image (or a PVC with volumeMode Block on ceph-rbd) → virt-launcher pod → nodeplugin maps the RBD image → /dev/rbdX becomes the VM disk · VM snapshots via ceph-rbd-snap → rbd snapshots" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FAFAFA;strokeColor=#8C8C8C;fontColor=#555555;dashed=1;dashPattern=5 3;" vertex="1" parent="C7"><mxGeometry x="16.0" y="154.0" width="558.0" height="50.0" as="geometry"/></mxCell><mxCell id="C5" value="Consumers — test namespace ceph-csi-test" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#EAF1FB;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="20.0" y="912.0" width="600.0" height="243.0" as="geometry"/></mxCell><mxCell id="C5pod" value="&lt;b&gt;Pod ceph-writer&lt;/b&gt;&lt;br&gt;ubi9-minimal, appends the date to /data/log.txt every 5 s&lt;br&gt;restricted-PSA compliant" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C5"><mxGeometry x="16.0" y="34.0" width="180.0" height="63.0" as="geometry"/></mxCell><mxCell id="C5pvcfs" value="&lt;b&gt;PVC ceph-rbd-fs&lt;/b&gt;&lt;br&gt;2Gi · RWO · volumeMode Filesystem (ext4)&lt;br&gt;storageClassName ceph-rbd" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C5"><mxGeometry x="212.0" y="34.0" width="180.0" height="63.0" as="geometry"/></mxCell><mxCell id="C5pvcblk" value="&lt;b&gt;PVC ceph-rbd-block&lt;/b&gt;&lt;br&gt;2Gi · RWO · volumeMode Block&lt;br&gt;storageClassName ceph-rbd (the shape of a VM disk)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C5"><mxGeometry x="408.0" y="34.0" width="176.0" height="63.0" as="geometry"/></mxCell><mxCell id="C5pv" value="&lt;b&gt;PV pvc-&amp;lt;uuid&amp;gt; × 2 — dynamic, bound 1:1 to the PVCs above&lt;/b&gt;&lt;br&gt;spec.csi.driver rbd.csi.ceph.com · volumeAttributes: clusterID ceph1 · pool ocp-rbd · &lt;b&gt;imageName csi-vol-&amp;lt;uuid&amp;gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C5"><mxGeometry x="16.0" y="111.0" width="376.0" height="76.0" as="geometry"/></mxCell><mxCell id="C5snap" value="&lt;b&gt;VolumeSnapshot ceph-rbd-fs-snap&lt;/b&gt;&lt;br&gt;class ceph-rbd-snap · source PVC ceph-rbd-fs → restored PVC ceph-rbd-fs-restore (clone)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="C5"><mxGeometry x="408.0" y="111.0" width="176.0" height="76.0" as="geometry"/></mxCell><mxCell id="C5note" value="&lt;b&gt;Provisioning flow:&lt;/b&gt; PVC created → csi-provisioner (ctrlplugin) → &lt;i&gt;rbd create&lt;/i&gt; in pool ocp-rbd → PV bound · pod scheduled → nodeplugin &lt;i&gt;rbd map&lt;/i&gt; + mkfs + mount (NodeStage / NodePublish) · PVC deleted → image removed (reclaimPolicy Delete)." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=wrap;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;" vertex="1" parent="C5"><mxGeometry x="16.0" y="201.0" width="568.0" height="32.0" as="geometry"/></mxCell><mxCell id="C9" value="Admin workstation · files · quick checks" style="swimlane;html=1;startSize=26;fontSize=12;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#F0F0F0;strokeColor=#8C8C8C;swimlaneFillColor=#FFFFFF;collapsible=0;whiteSpace=wrap;" vertex="1" parent="C"><mxGeometry x="640.0" y="912.0" width="590.0" height="243.0" as="geometry"/></mxCell><mxCell id="C9ws" value="&lt;b&gt;Windows 11 → WSL (Ubuntu)&lt;/b&gt; — oc 4.22.13 (kube:admin, cluster-admin) · helm 4.3.1 (not needed with the operator) · ssh rocky@192.168.200.66 → sudo -i (Ceph CLI as client.admin) · Proxmox: ssh root@mgt / web GUI&lt;br&gt;~/ceph-lab: ocp-driver-rbd.yaml · ocp-ceph-connection.yaml · ocp-rbd.yaml (Secret + SC + VSC) · ocp-test.yaml · ocp-test-snap.yaml" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontColor=#333333;" vertex="1" parent="C9"><mxGeometry x="16.0" y="34.0" width="558.0" height="76.0" as="geometry"/></mxCell><mxCell id="C9verify" value="&lt;b&gt;Quick verification&lt;/b&gt;&lt;br&gt;OpenShift: oc -n ceph-csi-operator-system get pods · oc get sc,volumesnapshotclass · oc -n ceph-csi-test get pvc,pod · oc get pv -o custom-columns=IMAGE:.spec.csi.volumeAttributes.imageName,PVC:.spec.claimRef.name · oc debug node/&amp;lt;node&amp;gt; -- chroot /host rbd showmapped&lt;br&gt;Ceph: ceph -s · ceph auth get client.ocp-rbd · rbd ls -l ocp-rbd · rbd du -p ocp-rbd · rbd status ocp-rbd/&amp;lt;image&amp;gt; (Watchers = node IP) · rbd image-meta list ocp-rbd/&amp;lt;image&amp;gt; · ceph tell mon.ceph1 sessions | grep ocp-rbd" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontColor=#333333;" vertex="1" parent="C9"><mxGeometry x="16.0" y="120.0" width="558.0" height="103.0" as="geometry"/></mxCell><mxCell id="B" value="NETWORK — one shared LAN (step 1b later)" style="swimlane;html=1;startSize=34;fontSize=13;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=3;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#F7FBF6;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780.0" y="96.0" width="220.0" height="1175.0" as="geometry"/></mxCell><mxCell id="e_driver_rt" value="creates all purple objects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;jettySize=auto;endArrow=block;endFill=1;strokeColor=#9673A6;strokeWidth=2;dashed=1;dashPattern=6 3;fontColor=#5E3A7A;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8233;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="C2driver" target="C3"><mxGeometry x="1.0000" y="0" relative="1" as="geometry"><mxPoint x="10.0" y="-4.0" as="offset"/></mxGeometry></mxCell><mxCell id="e_conn_cm" value="rendered into config.json" styl